# Optional overrides. The live values are baked into src/layouts/BaseLayout.astro,
# so a normal deploy needs none of this. Set these in Cloudflare Pages →
# Settings → Environment variables only if you want a different property
# (e.g. a staging GA stream).
#
# Both are build-time vars and must be prefixed PUBLIC_ to reach the browser.

# Google Analytics 4 measurement ID
PUBLIC_GA_MEASUREMENT_ID=G-Y0FGWCZLT6

# Google Search Console HTML meta verification token
PUBLIC_GSC_VERIFICATION=APSknz0js6C8MBDktsulu5nxFl67hw4jVq3qeS6GvDE
