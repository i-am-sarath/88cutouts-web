// Cloudflare Workers Builds deploy config. The site is fully static: `npm run build`
// writes it to ./dist and Workers serves it as static assets (no Worker script).
// _redirects in public/ is copied into dist and honoured by Workers static assets.
{
  "name": "88cutouts-web",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
