---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image path used for og:image / twitter:image. */
  image?: string;
  /** JSON-LD objects to embed in <head>. */
  jsonld?: unknown[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  jsonld = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://88cutouts.com').href;
const ogImage = new URL(image, Astro.site ?? 'https://88cutouts.com').href;

// Live values are baked in so a fresh deploy needs no dashboard config; the
// env vars exist only to override them (e.g. a staging property). Both tokens
// are public by design — they ship in the HTML either way.
// Analytics is suppressed on localhost at runtime, see the snippet below.
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-Y0FGWCZLT6';
const GSC_TOKEN =
  import.meta.env.PUBLIC_GSC_VERIFICATION ?? 'APSknz0js6C8MBDktsulu5nxFl67hw4jVq3qeS6GvDE';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {GSC_TOKEN && <meta name="google-site-verification" content={GSC_TOKEN} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="88cutouts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FFFCF8" />

    <link
      rel="preload"
      href="/fonts/quicksand-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/gaegu-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonld.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }

    {
      GA_ID && (
        <>
          <script is:inline define:vars={{ GA_ID }}>
            // Never count local development or `astro preview` traffic.
            var h = location.hostname;
            if (
              h !== 'localhost' &&
              h !== '127.0.0.1' &&
              h !== '[::1]' &&
              !h.endsWith('.local')
            ) {
              // The queue is set up immediately, so a page_view — or a Copy
              // tapped before the library arrives — is buffered in dataLayer
              // and flushed once gtag.js loads. Nothing is lost.
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () {
                dataLayer.push(arguments);
              };
              gtag('js', new Date());
              gtag('config', GA_ID);

              // gtag.js is ~170 KB. Loading it eagerly competes with the
              // thumbnails for bandwidth and pushed mobile LCP to 5.7s on the
              // gallery, so it waits until the page has finished loading.
              var load = function () {
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                document.head.appendChild(s);
              };
              var idle = function () {
                if (window.requestIdleCallback) requestIdleCallback(load, { timeout: 3000 });
                else setTimeout(load, 1200);
              };
              if (document.readyState === 'complete') idle();
              else addEventListener('load', idle, { once: true });
            }
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Toast />
  </body>
</html>
