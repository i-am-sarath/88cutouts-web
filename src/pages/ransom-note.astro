---
import BaseLayout from '../layouts/BaseLayout.astro';
import RansomNoteComposer from '../components/RansomNoteComposer.astro';

const site = Astro.site?.href ?? 'https://88cutouts.com/';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Ransom Note Generator',
    url: new URL('/ransom-note/', site).href,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    description:
      'Type a message and get it back as a cut-out ransom-note collage you can copy straight into an Instagram Story.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<BaseLayout
  title="Ransom note generator — cutout letter collage | 88cutouts"
  description="Type anything and watch it turn into a magazine-cutout ransom note. Copy or download the transparent PNG and paste it into your Instagram Story."
  jsonld={jsonld}
>
  <div class="wrap">
    <div class="section-head">
      <h2>Ransom note typewriter</h2>
    </div>
    <p class="lede">
      Type a message and each letter is swapped for a real cut-out scrap, tilted and
      jittered like it was snipped out of a magazine. Copy the result or download it as a
      transparent PNG.
    </p>

    <RansomNoteComposer />

    <article class="prose">
      <h2>How it works</h2>
      <p>
        Every letter, number and common punctuation mark in this tool is a real photo of a
        cut-out paper scrap — snipped from magazine pages, tilted slightly, and photographed
        so the edges keep their texture. When you type, each character is swapped for its
        scrap and given a small random rotation and offset, the same way a real ransom-note
        collage never lines up perfectly. The whole thing renders in your browser: nothing
        you type is sent anywhere or stored.
      </p>

      <h2>Using it in a Story</h2>
      <p>
        Once the collage renders, <strong>Copy</strong> puts it on your clipboard as a
        transparent PNG — open Instagram, start a Story, and long-press to paste. It drops in
        without a white box around it. If your browser doesn't support copying images
        directly (some older mobile browsers don't), <strong>Download</strong> saves the same
        PNG so you can add it as a sticker manually.
      </p>
      <p>
        It reads best short — a name, a date, a single line like "happy birthday" or
        "save the date" — since longer sentences shrink to fit and lose the cut-out texture
        at small sizes. Pairing it with one of the <a href="/category/hearts/">hearts</a> or
        <a href="/category/coquette/">coquette</a> stickers as a border tends to look better
        than the text alone.
      </p>

      <h2>FAQ</h2>
      <h3>Does it work with emoji or accented letters?</h3>
      <p>
        Only the letters, numbers and punctuation that have a matching cut-out scrap will
        render — anything else is skipped. Coverage is plain A–Z (either case — it's not
        case-sensitive), 0–9, and the punctuation marks . , ! ? " ' - : ; ( ) @ # % + * & &gt;.
      </p>
      <h3>Is the image free to use?</h3>
      <p>
        Yes — same terms as the rest of the site: free for personal use on your own Stories,
        chats and notes. See the <a href="/about/">about page</a> for the details.
      </p>
      <h3>Why does it look different every time I type the same word?</h3>
      <p>
        Each letter is picked from a small pool of scrap variants and given a fresh random
        tilt, so retyping the same word won't produce an identical collage twice. That's
        intentional — it's meant to look hand-assembled, not templated.
      </p>
    </article>
</div>
</BaseLayout>
