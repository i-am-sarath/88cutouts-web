---
import { getStickers } from '../lib/stickers';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPacks } from '../lib/packs';
import { stickerThumb } from '../lib/thumbs.mjs';
import { templates } from '../data/scrapbook-templates';
import geometry from '../data/sticker-geometry.json';

const all = await getStickers();

const stickers = [...all].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const packs = await getPacks();

/** One emoji per mood, for the chip row. */
const CAT_ICON: Record<string, string> = {
  cute: '🐱', coquette: '🎀', flowers: '🌸', aesthetic: '✨', retro: '📼', hearts: '💗',
  y2k: '💿', paper: '📎', text: '💬', frames: '🖼️', seasonal: '🍂', general: '⭐',
};
const catCounts = new Map<string, number>();
for (const s of all) catCounts.set(s.data.category, (catCounts.get(s.data.category) ?? 0) + 1);
const chipCats = [...catCounts].sort((a, b) => b[1] - a[1]).map(([c]) => c);

/**
 * Pale artwork (white lace, chrome, silver) disappears on a light checker, so
 * it gets a dark tile. Measured at build time by scripts/sticker-geometry.mjs.
 */
const pale = (image: string) => ((geometry as Record<string, { lum?: number }>)[image]?.lum ?? 0) > 205;

const gallery = stickers.map((s) => ({
  s: s.slug,
  t: s.data.title,
  c: s.data.category,
  f: s.data.featured ? 1 : 0,
  d: s.data.date.valueOf(),
  th: stickerThumb(s.data.image, 400),
  png: s.data.image,
  k: pale(s.data.image) ? 1 : 0,
}));
/** Shown before scripts run, and to search engines: featured first, then newest. */
const firstPage = gallery.slice(0, 42);

const site = Astro.site?.href ?? 'https://88cutouts.com/';

const faq = [
  {
    q: 'Is the scrapbook maker really free?',
    a: 'Yes. There is no account, no watermark and no paid tier. Make a page from your photos, the stickers here and cut-out letters, save it as an image and post it anywhere.',
  },
  {
    q: 'Are my photos uploaded?',
    a: 'No. The scrapbook maker draws your page in your own browser. Photos are never sent anywhere, which is also why nothing is saved: download your page before you close the tab.',
  },
  {
    q: 'Are these stickers really free?',
    a: 'Yes. Every cutout here is free for personal use on your own Stories, posts, chats and notes. There is no account, no watermark and no attribution requirement. The full terms are on the licence page.',
  },
  {
    q: 'Do I need an app to use them?',
    a: 'No. Open a sticker, tap Copy, then long-press inside an Instagram Story to paste it. Or add it to a scrapbook page with your photos. Everything happens in your browser.',
  },
  {
    q: 'Why does my sticker have a white box around it?',
    a: 'Because it landed somewhere that flattens transparency. Instagram Stories keep the alpha channel; feed posts and some chat apps do not. Pasting into a Story, or saving the PNG and adding it as a sticker, keeps the edges clean.',
  },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '88cutouts',
    url: site,
    description: 'Free online scrapbook maker and aesthetic transparent stickers for Instagram.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free aesthetic stickers and scrapbook maker',
    description:
      'Make scrapbook pages from your photos, and copy free transparent PNG stickers into your Instagram Stories. No login.',
    url: site,
    isPartOf: { '@type': 'WebSite', name: '88cutouts', url: site },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: stickers.length,
      itemListElement: stickers.slice(0, 30).map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/stickers/${s.slug}/`, site).href,
        name: s.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Free aesthetic stickers — copy & paste into Instagram Stories | 88cutouts"
  description={`${all.length} free transparent PNG stickers: bows, flowers, cats, y2k, frames and washi tape. Tap Copy and paste into your Instagram Story, or make a scrapbook page with them. No login, no app.`}
  jsonld={jsonld}
>
  <div class="wrap sg">
    <div class="sg-top">
      <div>
        <h1>Free aesthetic stickers</h1>
        <p class="sg-sub">{all.length} transparent PNGs. Tap <b>Copy</b>, paste into your Story. No login, no watermark.</p>
      </div>
      <div class="sg-bg" role="group" aria-label="Tile background">
        <button type="button" data-tiles="auto" aria-pressed="true">Auto</button>
        <button type="button" data-tiles="light" aria-pressed="false">Light</button>
        <button type="button" data-tiles="dark" aria-pressed="false">Dark</button>
      </div>
    </div>

    <nav class="sg-chips" aria-label="Sticker filters">
      <button type="button" class="sg-chip" data-filter="for-you" aria-pressed="true">For you</button>
      <button type="button" class="sg-chip" data-filter="new" aria-pressed="false">🆕 New</button>
      <button type="button" class="sg-chip" data-filter="popular" aria-pressed="false">🔥 Popular</button>
      <button type="button" class="sg-chip" data-filter="all" aria-pressed="false">All</button>
      {chipCats.map((c) => (
        <a class="sg-chip" href={`/category/${c}/`} data-filter={c} aria-pressed="false">{CAT_ICON[c] ?? '•'} {c}</a>
      ))}
      <a class="sg-chip" href="/packs/">📦 Packs</a>
      <a class="sg-chip" href="/symbols/">✧ Symbols</a>
    </nav>

    <div class="sg-grid" id="sg-grid" data-tiles="auto">
      {firstPage.map((g, i) => (
        <>
          {i === 14 && (
            <a class="sg-promo" href="/scrapbook/?template=love-letter-poem">
              <img src="/scrapbook/previews/love-letter-poem.webp" alt="" width="540" height="960" loading="lazy" />
              <span>Put them on a scrapbook page →</span>
            </a>
          )}
          <div class="sg-tile" data-dark={g.k ? '' : undefined}>
            <a href={`/stickers/${g.s}/`} title={g.t}>
              <img src={g.th} alt={`${g.t} — transparent PNG sticker`} width="400" height="400" loading={i < 14 ? 'eager' : 'lazy'} decoding="async" />
            </a>
            <button type="button" class="sg-copy" data-png={g.png} data-slug={g.s} aria-label={`Copy ${g.t}`}>Copy</button>
            <a class="sg-add" href={`/scrapbook/?add=${g.s}`} aria-label={`Add ${g.t} to a scrapbook page`} title="Add to a scrapbook page">+</a>
          </div>
        </>
      ))}
    </div>
    <p class="sg-empty" id="sg-empty" hidden>Nothing here yet.</p>
    <div class="sg-more"><a class="btn-download" id="sg-more" href="/stickers/">See all {all.length} stickers</a></div>
  </div>

  <script type="application/json" id="sg-data" set:html={JSON.stringify(gallery)} />

  <section class="home-hero">
    <div class="wrap home-hero-in">
      <div class="home-hero-copy">
        <p class="kicker">scrapbook maker · free · photos stay on your phone</p>
        <h2 class="home-hero-title">Then make a scrapbook page with them</h2>
        <p class="home-hero-sub">
          Your photos, {all.length} aesthetic stickers, cut-out magazine letters and washi tape
          on real-looking paper. Save it for your Story or feed in a minute.
        </p>
        <div class="action-row">
          <a class="btn-copy btn-big" href="/scrapbook/?template=love-letter-poem">Make a page like this →</a>
          <a class="btn-download btn-big" href="/scrapbook/">Start blank</a>
        </div>
      </div>

      <div class="home-hero-art">
        <img class="hero-page hero-page-l" loading="lazy" src="/scrapbook/previews/keepsake-journal.webp" alt="" width="540" height="960" />
        <img class="hero-page hero-page-r" loading="lazy" src="/scrapbook/previews/tropical-soulmates.webp" alt="" width="540" height="960" />
        <a class="hero-page hero-page-main" href="/scrapbook/?template=love-letter-poem">
          <img src="/scrapbook/previews/love-letter-poem.webp" alt="A finished scrapbook page: three rounded photos, orange crayon spirals, a lyric card and a love poem cut out word by word" width="540" height="960" loading="lazy" />
          <span class="hero-make">Make this one →</span>
        </a>
        <span class="hero-word" aria-hidden="true">made in 2 min</span>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="home-steps" aria-label="How it works">
      <div class="step"><b>1</b><h2>Pick a template</h2><p>Or start blank on cream, kraft, grid or lined paper.</p></div>
      <div class="step"><b>2</b><h2>Add your photos</h2><p>They drop into the frames. Nothing is uploaded.</p></div>
      <div class="step"><b>3</b><h2>Decorate</h2><p>Stickers, cut-out letters, handwriting, symbols and tape.</p></div>
      <div class="step"><b>4</b><h2>Save &amp; post</h2><p>Story, post or square size, ready for Instagram.</p></div>
    </section>

    <section>
      <div class="section-head">
        <h2>Start from a template</h2>
        <a class="count" href="/scrapbook/">Blank page →</a>
      </div>
      <div class="tpl-cards">
        {
          templates.map((t) => (
            <a class="tpl-card" href={`/scrapbook/${t.slug}/`}>
              <img class="tpl-card-pic" src={`/scrapbook/previews/${t.slug}.webp`} alt="" width="540" height="960" loading="lazy" decoding="async" />
              <b>{t.name}</b>
              <span>{t.blurb}</span>
            </a>
          ))
        }
      </div>
    </section>

    {
      packs.length > 0 && (
        <section class="pack-strip">
          <div class="section-head">
            <h2>Sticker packs</h2>
            <a class="count" href="/packs/">All {packs.length} packs →</a>
          </div>
          <p class="lede">
            Themed sets picked to go together. Copy a whole pack into your Story in one tap, or
            open it in the scrapbook maker.
          </p>
          <div class="pack-grid">
            {packs.slice(0, 4).map((p) => (
              <a class="pack-card" href={`/packs/${p.slug}/`}>
                <div class="pack-thumbs">
                  {p.entries.slice(0, 4).map((e) => (
                    <img src={stickerThumb(e.data.image, 200)} alt="" width="200" height="200" loading="lazy" decoding="async" />
                  ))}
                </div>
                <div class="card-meta">
                  <div class="card-title">{p.name}</div>
                  <div class="card-sub">{p.entries.length} stickers</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <a class="home-symbols" href="/symbols/">
      <span class="home-symbols-art" aria-hidden="true">✧ · ♡ · ✦<br />˚ ☾ ⋆ ˚</span>
      <span>
        <b>Symbols &amp; dot art</b>
        Copy-and-paste text decorations for your bio, captions and notes, or add them to a
        scrapbook page.
      </span>
    </a>

    <AdSlot />

    <article class="prose home-prose">
      <h2>A scrapbook without the glue</h2>
      <p>
        A scrapbook page is a handful of photos that belong together, stuck down a little
        crooked, with some tape, a few bits of decoration and a line of writing that says why
        they matter. The <a href="/scrapbook/">scrapbook maker</a> here does that on screen:
        pick a paper, drop in your photos, and dress them with the same transparent stickers
        this site has always offered, a title in cut-out magazine letters and a strip or two of
        washi tape. Save the page as an Instagram Story, a 4:5 feed post or a square.
      </p>
      <p>
        It runs in your browser with no account. Your photos are opened on your own device
        and never uploaded, so there is nothing to sign up for and nothing stored. That also
        means pages are not saved: download each one when it is done. {templates.length}
        <a href="/scrapbook/love-letter-poem/">ready-made templates</a> cover love-letter poems,
        tropical collages, travel postcards, photo-booth walls, film rolls and keepsake journals.
      </p>

      <h2>What the stickers are, and how to use them</h2>
      <p>
        Every cutout on this site is a transparent PNG — a piece of artwork with no
        background at all, rather than a picture of artwork on a white square. That
        difference is the whole point. Paste a transparent PNG into an Instagram Story and
        it lands as a sticker you can pinch, rotate and place over your photo. Paste a
        flattened one and you get a white box sitting in the middle of your image.
      </p>
      <p>
        The usual route is: open a sticker, tap <strong>Copy</strong>, switch to Instagram,
        start a Story, then tap once on the screen and long-press to paste. If your browser
        will not copy images, <strong>Download</strong> saves the same PNG to your camera roll
        and you can add it from there. The
        <a href="/blog/how-to-add-stickers-to-instagram-stories/">full walkthrough</a>
        covers both routes, plus WhatsApp and the places transparency gets flattened.
      </p>

      <h2>Solid, soft or see-through</h2>
      <p>
        Every sticker page carries an opacity control. At full strength a cutout reads as
        the subject of the Story. Around 70% it softens into the photo underneath. Below
        45% it behaves like a watermark — present without competing with whatever you
        photographed. The transparency is written into the PNG itself, so what the preview
        shows is exactly what gets copied.
      </p>

      <h2>Finding the right one</h2>
      <p>
        The chips along the top filter by mood: coquette bows, flowers, retro bits, y2k
        cameras and disco balls, paper scraps and washi tape, frames with see-through
        windows. White and silver cutouts sit on a dark tile so you can actually see them;
        flip every tile dark or light with the switch above the grid. Each sticker page
        shows the file and artwork dimensions, and there are themed packs when you want a
        set that already matches.
      </p>
      <p>
        To make your own cutouts, the
        <a href="/blog/how-to-make-transparent-png-stickers/">guide to cutting transparent PNGs</a>
        walks through the edge decontamination step most tutorials skip — it is the reason
        stickers from elsewhere often show a faint outline once they are on a photo.
      </p>

      <h2>Common questions</h2>
      {
        faq.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }
    </article>
  </div>
</BaseLayout>

<script>
  import { copyImage } from '../lib/sticker-actions';

  interface G { s: string; t: string; c: string; f: number; d: number; th: string; png: string; k: number }
  const all: G[] = JSON.parse(document.getElementById('sg-data')!.textContent || '[]');
  const grid = document.getElementById('sg-grid')!;
  const more = document.getElementById('sg-more') as HTMLAnchorElement;
  const promo = grid.querySelector('.sg-promo');
  const PAGE = 42;

  // "For you" is the order the page was built in (featured, then newest), so
  // the first screen never swaps images under the visitor.
  const lists: Record<string, () => G[]> = {
    'for-you': () => all,
    new: () => [...all].sort((a, b) => b.d - a.d),
    popular: () => all.filter((g) => g.f),
    all: () => [...all].sort((a, b) => a.t.localeCompare(b.t)),
  };

  let list: G[] = all;
  let shown = grid.querySelectorAll('.sg-tile').length;

  function tile(g: G, eager: boolean) {
    const el = document.createElement('div');
    el.className = 'sg-tile';
    if (g.k) el.dataset.dark = '';
    const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    el.innerHTML =
      `<a href="/stickers/${g.s}/" title="${esc(g.t)}"><img src="${g.th}" alt="${esc(g.t)} — transparent PNG sticker" width="400" height="400" loading="${eager ? 'eager' : 'lazy'}" decoding="async"></a>` +
      `<button type="button" class="sg-copy" data-png="${g.png}" data-slug="${g.s}" aria-label="Copy ${esc(g.t)}">Copy</button>` +
      `<a class="sg-add" href="/scrapbook/?add=${g.s}" aria-label="Add ${esc(g.t)} to a scrapbook page" title="Add to a scrapbook page">+</a>`;
    return el;
  }

  function page() {
    const frag = document.createDocumentFragment();
    for (const g of list.slice(shown, shown + PAGE)) {
      frag.append(tile(g, shown < 14));
      shown++;
      if (shown === 14 && promo) frag.append(promo);
    }
    grid.append(frag);
    more.hidden = shown >= list.length;
    more.textContent = `Show more (${list.length - shown})`;
  }

  function show(filter: string) {
    list = (lists[filter] ?? (() => all.filter((g) => g.c === filter)))();
    shown = 0;
    grid.replaceChildren();
    document.getElementById('sg-empty')!.hidden = list.length > 0;
    page();
  }

  document.querySelectorAll<HTMLElement>('.sg-chip[data-filter]').forEach((chip) =>
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      document.querySelectorAll('.sg-chip[data-filter]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      show(chip.dataset.filter!);
      if (grid.getBoundingClientRect().top < 0) grid.scrollIntoView({ block: 'start' });
    })
  );

  more.addEventListener('click', (e) => {
    e.preventDefault();
    page();
  });
  // Keep going as the visitor scrolls, like an app.
  new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !more.hidden && shown > 0 && shown < 210) page();
  }, { rootMargin: '600px' }).observe(more);

  grid.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.sg-copy');
    if (!btn) return;
    const ok = await copyImage(btn.dataset.png!, btn.dataset.slug!);
    if (ok) {
      btn.textContent = 'Copied ✓';
      btn.classList.add('done');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('done'); }, 1600);
    }
  });

  // Tile background: automatic per sticker, or all light / all dark.
  const KEY = '88cutouts-tiles';
  const setTiles = (mode: string) => {
    grid.dataset.tiles = mode;
    document.querySelectorAll('[data-tiles]').forEach((b) => b !== grid && b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.tiles === mode)));
    try { localStorage.setItem(KEY, mode); } catch { /* fine for this visit */ }
  };
  document.querySelectorAll<HTMLButtonElement>('button[data-tiles]').forEach((b) => b.addEventListener('click', () => setTiles(b.dataset.tiles!)));
  try { const saved = localStorage.getItem(KEY); if (saved) setTiles(saved); } catch { /* storage blocked */ }

  more.hidden = shown >= list.length;
  more.textContent = `Show more (${list.length - shown})`;
</script>

