---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/dp.css';
import DpCard from '../../components/DpCard.astro';
import { dpCollections, getAllDps, getDpsIn } from '../../lib/dps';

const all = await getAllDps();

// Each collection contributes a short preview strip on the hub; the full set
// lives on its own page, which is the one built to rank.
const strips = (
  await Promise.all(
    dpCollections.map(async (c) => ({ meta: c, dps: (await getDpsIn(c.slug)).slice(0, 6) }))
  )
).filter((s) => s.dps.length > 0);

const site = Astro.site?.href ?? 'https://88cutouts.com/';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free DP and profile pictures',
    description:
      'Free DP and profile pictures for WhatsApp and Instagram — tap to copy or download.',
    url: new URL('/dp/', site).href,
    isPartOf: { '@type': 'WebSite', name: '88cutouts', url: site },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: dpCollections.length,
      itemListElement: dpCollections.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/dp/${c.slug}/`, site).href,
        name: c.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'DP', item: new URL('/dp/', site).href },
    ],
  },
];
---

<BaseLayout
  title="Free DP & profile pictures for WhatsApp and Instagram | 88cutouts"
  description={`Free DP and profile pictures — girls, attitude, sad, stylish, aesthetic and cute. Tap to copy or download, no account needed.`}
  image={all[0]?.image}
  jsonld={jsonld}
>
  <section class="hero">
    <div class="wrap">
      <h1>Free DP &amp; profile pictures</h1>
      <p>
        {
          all.length > 0
            ? `${all.length} profile pictures for WhatsApp, Instagram and anywhere else — tap to copy, no account needed.`
            : 'Profile pictures for WhatsApp, Instagram and anywhere else — tap to copy or download.'
        }
      </p>
      <div class="rule"></div>
    </div>
  </section>

  <div class="wrap">
    <nav class="pills" aria-label="DP collections">
      {dpCollections.map((c) => <a class="pill" href={`/dp/${c.slug}/`}>{c.name}</a>)}
    </nav>

    {
      strips.length === 0 && (
        <section class="dp-empty">
          <h2>The gallery is being restocked</h2>
          <p>
            New DPs are added by hand, so there is nothing here just yet. The sticker
            library is still full, though.
          </p>
          <a class="btn-copy" href="/">Browse stickers</a>
        </section>
      )
    }

    {
      strips.map(({ meta, dps }) => (
        <>
          <div class="section-head">
            <h2>{meta.name}</h2>
            <a class="count" href={`/dp/${meta.slug}/`}>
              See all →
            </a>
          </div>
          <p class="lede">{meta.blurb}</p>
          <div class="grid dp-grid">
            {dps.map((dp, i) => (
              <DpCard dp={dp} eager={i < 3 && meta.slug === strips[0].meta.slug} />
            ))}
          </div>
        </>
      ))
    }

    <article class="prose category-prose">
      <h2>What makes a good profile picture</h2>
      <p>
        Almost everywhere a profile picture appears — WhatsApp, Instagram, Telegram,
        Discord, a work chat — it is cropped to a circle and then drawn very small. In a
        WhatsApp chat list it is about 50 pixels across. On an Instagram profile it is
        around 110. Those two facts decide everything else about what works.
      </p>
      <p>
        Cropping to a circle throws away the four corners of your square, which is roughly a
        fifth of the image. Anything you care about has to sit inside the circle, and
        anything decorative near a corner is not decoration — it is deleted. Every picture
        in this gallery is composed with that in mind, which is why none of them place
        anything important in a corner.
      </p>
      <p>
        The display size decides the rest. At 50 pixels a face is a handful of dots, text is
        a smear and a busy background is noise. What survives is a single clear subject with
        real tonal contrast against whatever is behind it. The full argument, including why
        changing your picture often works against you, is in
        <a href="/blog/how-to-choose-a-profile-picture/">how to choose a profile picture</a>.
      </p>

      <h2>Light theme and dark theme</h2>
      <p>
        Your picture is shown against a light background for some people and a dark one for
        others, and you do not get to pick. A very pale image vanishes into the light theme;
        a very dark one vanishes into the dark theme. A mid-tone image with one bright point
        of focus survives both, which is the quiet rule behind most of the sets here.
      </p>

      <h2>Do not upload a transparent PNG</h2>
      <p>
        This is the single most common way a profile picture goes wrong. If you upload a PNG
        with transparency, every app fills that transparency with whatever colour it
        happens to use — often grey, sometimes black, occasionally white — and the result is
        rarely what you pictured. Flatten it yourself against a background you chose, and
        upload that. The longer explanation is in
        <a href="/blog/transparent-png-turns-grey-explained/">why a transparent PNG turns grey</a>.
      </p>

      <h2>Sizing</h2>
      <p>
        Upload square, and at least 500 × 500 pixels. Everything in this gallery is 900 × 900
        or larger, which is comfortably above what WhatsApp and Instagram need and leaves
        room for their compression without the image going soft. Bigger than about 1500
        pixels is wasted — it gets resized on upload either way. The numbers, per platform,
        are in the <a href="/blog/whatsapp-dp-size-guide/">DP size guide</a>.
      </p>

      <h2>Using these</h2>
      <p>
        Every picture here is free for personal use. Open one, tap <strong>Copy</strong> to
        put it on your clipboard or <strong>Download</strong> for the full-size file, then
        set it as your profile picture the way you normally would. There is no account and
        nothing to install. If you would rather decorate a Story than change your profile,
        the <a href="/">sticker library</a> is the other half of this site.
      </p>
    </article>
  </div>
</BaseLayout>
