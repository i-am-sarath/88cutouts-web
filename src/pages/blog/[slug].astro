---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      // Same category first, then anything else, so a short blog still fills
      // the three related slots.
      related: [
        ...posts.filter((p) => p.slug !== post.slug && p.data.category === post.data.category),
        ...posts.filter((p) => p.slug !== post.slug && p.data.category !== post.data.category),
      ].slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { title, description, date, updated, category, tags, cover, faq } = post.data;
const { Content, headings } = await post.render();

// ~220 wpm is the usual figure for screen reading of this kind of prose.
const words = post.body.trim().split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));

// Only h2s go in the contents list — h3s would make it longer than some of the
// sections it points at.
const toc = headings.filter((h) => h.depth === 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const site = Astro.site?.href ?? 'https://88cutouts.com/';
const pageUrl = new URL(`/blog/${post.slug}/`, site).href;
const ogImage = cover ?? '/og-default.png';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString().slice(0, 10),
    dateModified: (updated ?? date).toISOString().slice(0, 10),
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    image: new URL(ogImage, site).href,
    wordCount: words,
    keywords: [category, ...tags].join(', '),
    inLanguage: 'en',
    author: { '@type': 'Person', name: 'Sarath', url: new URL('/about/', site).href },
    publisher: {
      '@type': 'Organization',
      name: '88cutouts',
      url: site,
      logo: { '@type': 'ImageObject', url: new URL('/og-default.png', site).href },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
  ...(faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout title={`${title} | 88cutouts`} description={description} image={ogImage} jsonld={jsonld}>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span>{title}
    </p>

    <article class="post">
      <header class="post-head">
        <span class="post-cat">{category}</span>
        <h1>{title}</h1>
        <p class="post-standfirst">{description}</p>
        <p class="post-byline">
          <time datetime={date.toISOString().slice(0, 10)}>{fmt(date)}</time>
          {updated && <> · updated {fmt(updated)}</>}
          · {minutes} min read
        </p>
      </header>

      {
        toc.length > 2 && (
          <nav class="post-toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="post-body">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="meta post-tags">
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }

      {
        faq.length > 0 && (
          <section class="post-faq">
            <h2>Common questions</h2>
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }

      <aside class="post-cta">
        <h2>Try it with the real thing</h2>
        <p>
          Everything described here works with the free library on this site — transparent
          PNG <a href="/">stickers and frames</a>, ready-made
          <a href="/dp/">profile pictures</a>, a <a href="/dp-maker/">DP maker</a> that turns
          your own photo into a circular PNG, and the
          <a href="/ransom-note/">ransom-note typewriter</a>. No account, nothing to install.
        </p>
      </aside>
    </article>

    {
      related.length > 0 && (
        <>
          <div class="section-head">
            <h2>Keep reading</h2>
            <a class="count" href="/blog/">
              All articles →
            </a>
          </div>
          <div class="post-grid">
            {related.map((p) => (
              <BlogCard entry={p} />
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
