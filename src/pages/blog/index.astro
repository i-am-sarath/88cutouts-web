---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const [latest, ...rest] = posts;

const site = Astro.site?.href ?? 'https://88cutouts.com/';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: '88cutouts Blog',
    description:
      'Guides on Instagram Story stickers, transparent PNGs, profile pictures and the aesthetics behind them.',
    url: new URL('/blog/', site).href,
    isPartOf: { '@type': 'WebSite', name: '88cutouts', url: site },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.date.toISOString().slice(0, 10),
      url: new URL(`/blog/${p.slug}/`, site).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
    ],
  },
];
---

<BaseLayout
  title="Blog — guides to stickers, Stories and profile pictures | 88cutouts"
  description="Practical guides on adding stickers to Instagram Stories, transparent PNGs, WhatsApp DP sizes and the aesthetics behind them. Written by hand, no fluff."
  jsonld={jsonld}
>
  <section class="hero">
    <div class="wrap">
      <h1>The 88cutouts blog</h1>
      <p>
        Everything we've worked out while making this library — how to paste a sticker into
        a Story without a white box, what size a profile picture actually needs to be, why
        transparency survives in some places and dies in others, and how the aesthetics
        people ask for are put together. No listicles, no filler.
      </p>
      <div class="rule"></div>
    </div>
  </section>

  <div class="wrap">
    {
      posts.length === 0 ? (
        <p class="lede">No posts yet.</p>
      ) : (
        <>
          <div class="section-head">
            <h2>Latest</h2>
            <span class="count">{posts.length} articles</span>
          </div>

          <div class="post-grid">
            <BlogCard entry={latest} wide eager />
            {rest.map((p, i) => (
              <BlogCard entry={p} eager={i < 3} />
            ))}
          </div>
        </>
      )
    }

    <article class="prose category-prose">
      <h2>Where to start</h2>
      <p>
        The posts here fall into three groups, and which one you want depends on what went
        wrong.
      </p>

      <h3>Getting a sticker into a Story</h3>
      <p>
        If the mechanics are the problem — the paste does not work, the sticker arrives with
        a white box, the image looks soft — start with
        <a href="/blog/how-to-add-stickers-to-instagram-stories/">adding stickers to Instagram Stories</a>,
        then <a href="/blog/transparent-png-turns-grey-explained/">why a transparent PNG turns grey</a>,
        which explains the white-box problem properly. <a href="/blog/copy-image-to-clipboard-guide/">Copying an image to the clipboard</a>
        covers the browsers that refuse, and what to do instead.
      </p>

      <h3>Sizes, formats and the technical side</h3>
      <p>
        <a href="/blog/instagram-story-size-and-safe-zones/">Story size and safe zones</a> is
        the one most people need: it explains why the top and bottom of a 1080 × 1920 frame
        are not really yours to use. <a href="/blog/whatsapp-dp-size-guide/">The WhatsApp DP size guide</a>
        does the same for profile pictures, <a href="/blog/png-jpg-webp-svg-image-formats/">PNG, JPG, WebP and SVG</a>
        explains which format to save what in, and
        <a href="/blog/how-to-make-transparent-png-stickers/">making transparent PNG stickers</a>
        is the full production process behind everything in this library.
      </p>

      <h3>Aesthetics and putting a look together</h3>
      <p>
        <a href="/blog/build-a-cohesive-instagram-aesthetic/">Building a cohesive Instagram aesthetic</a>
        is the general argument; the rest are specific looks —
        <a href="/blog/coquette-aesthetic-guide/">coquette</a>,
        <a href="/blog/y2k-aesthetic-guide/">Y2K</a>,
        <a href="/blog/ransom-note-aesthetic-guide/">the ransom note style</a> and
        <a href="/blog/digital-scrapbook-collage-guide/">digital scrapbook collage</a>.
        <a href="/blog/instagram-highlight-covers-guide/">Highlight covers</a> and
        <a href="/blog/how-to-choose-a-profile-picture/">choosing a profile picture</a> deal
        with the two parts of a profile that people tend to leave until last.
      </p>

      <h2>Why these are written this way</h2>
      <p>
        Every post here exists because the same question kept coming up while making the
        sticker library, and the answers available online were either wrong or padded out to
        two thousand words for the sake of it. These are written to be read once and
        remembered. Where a post can end after eight hundred words, it does.
      </p>
      <p>
        Nothing here is sponsored and no post exists to sell anything — the library itself is
        free. If something in one of them is wrong, say so:
        <a href="mailto:hello@88cutouts.com">hello@88cutouts.com</a>.
      </p>
    </article>
  </div>
</BaseLayout>
