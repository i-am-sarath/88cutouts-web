---
import type { CollectionEntry } from 'astro:content';
import { getStickers } from '../../lib/stickers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPills from '../../components/CategoryPills.astro';
import StickerCard from '../../components/StickerCard.astro';
import StickerShuffle from '../../components/StickerShuffle.astro';
import { categoryPage } from '../../lib/category-copy';

export async function getStaticPaths() {
  const all = await getStickers();
  const categories = [...new Set(all.map((s) => s.data.category))];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      items: all
        .filter((s) => s.data.category === category)
        .sort((a, b) => {
          if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
          return b.data.date.valueOf() - a.data.date.valueOf();
        }),
      elsewhere: all.filter((s) => s.data.category !== category),
      siblings: categories.filter((c) => c !== category),
    },
  }));
}

interface Props {
  category: string;
  items: CollectionEntry<'stickers'>[];
  elsewhere: CollectionEntry<'stickers'>[];
  siblings: string[];
}

const { category, items, elsewhere, siblings } = Astro.props;
const site = Astro.site?.href ?? 'https://88cutouts.com/';
const label = category.charAt(0).toUpperCase() + category.slice(1);

const page = categoryPage(category);

/** Newest three, named in the prose so the page links its own contents. */
const newest = [...items]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${label} stickers for Instagram Stories`,
    description: page.intro,
    url: new URL(`/category/${category}/`, site).href,
    isPartOf: { '@type': 'WebSite', name: '88cutouts', url: site },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: items.length,
      itemListElement: items.slice(0, 30).map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/stickers/${s.slug}/`, site).href,
        name: s.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      {
        '@type': 'ListItem',
        position: 2,
        name: label,
        item: new URL(`/category/${category}/`, site).href,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={`${label} stickers — free transparent PNGs for Instagram Stories | 88cutouts`}
  description={`${items.length} free ${category} stickers as transparent PNGs. Copy at any opacity and paste straight into your Instagram Story — no login needed.`}
  image={items[0]?.data.image}
  jsonld={jsonld}
>
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a><span>/</span>{label}</p>

    <div class="section-head">
      <h2>{label} stickers</h2>
      <span class="count">{items.length} items</span>
    </div>
    <p class="category-intro">{page.intro}</p>

    <CategoryPills active={category} />

    <div class="grid">
      {items.map((entry, i) => <StickerCard entry={entry} eager={i < 6} />)}
    </div>

    <article class="prose category-prose">
      {
        page.sections.map((section) => (
          <>
            <h2>{section.h}</h2>
            {section.p.map((para) => (
              <p>{para}</p>
            ))}
          </>
        ))
      }

      {
        newest.length > 0 && (
          <>
            <h2>Most recent in this set</h2>
            <p>
              The newest additions are{' '}
              {newest.map((s, i) => (
                <>
                  {i > 0 && (i === newest.length - 1 ? ' and ' : ', ')}
                  <a href={`/stickers/${s.slug}/`}>{s.data.title}</a>
                </>
              ))}
              . Every one of them is a transparent PNG with an opacity control on its page,
              so the same cutout can be copied solid or faded down to sit under a photo.
            </p>
          </>
        )
      }

      {
        siblings.length > 0 && (
          <>
            <h2>Other sets</h2>
            <p>
              If this is not quite the mood, try{' '}
              {siblings.slice(0, 5).map((c, i) => (
                <>
                  {i > 0 && (i === Math.min(siblings.length, 5) - 1 ? ' or ' : ', ')}
                  <a href={`/category/${c}/`}>{c}</a>
                </>
              ))}
              . There is also the <a href="/ransom-note/">cutout text maker</a> for a whole
              phrase in paper letters, and the <a href="/dp/">DP gallery</a> for profile
              pictures.
            </p>
          </>
        )
      }

      <p class="page-aside">
        Every cutout above copies at whatever opacity you set on its own page. The mechanics
        are covered once in
        <a href="/blog/how-to-add-stickers-to-instagram-stories/">adding stickers to Stories</a>.
      </p>

      <h2>Questions about {category} stickers</h2>
      {
        page.faq.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }
    </article>

    <StickerShuffle
      pool={elsewhere}
      count={6}
      id="category"
      heading="From the rest of the library"
      blurb="Six at random from the other shelves — shuffle until something fits the photo you have in mind."
    />
  </div>
</BaseLayout>
