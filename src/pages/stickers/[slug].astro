---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyDownloadButtons from '../../components/CopyDownloadButtons.astro';
import StickerCard from '../../components/StickerCard.astro';
import AdSlot from '../../components/AdSlot.astro';

export async function getStaticPaths() {
  const items = await getCollection('stickers');
  return items.map((s) => ({
    params: { slug: s.slug },
    props: {
      entry: s,
      related: items
        .filter((r) => r.slug !== s.slug && r.data.category === s.data.category)
        .slice(0, 6),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'stickers'>;
  related: CollectionEntry<'stickers'>[];
}

const { entry, related } = Astro.props;
const { title, image, category, type } = entry.data;
// The category already has its own chip — don't repeat it in the tag row.
const tags = entry.data.tags.filter((t) => t.toLowerCase() !== category.toLowerCase());

// Hero shows the lightweight WebP; Copy/Download still fetch the full PNG.
const heroThumb = `/stickers/thumbs/${image
  .replace(/^\/stickers\//, '')
  .replace(/\.png$/i, '')}-512.webp`;

const site = Astro.site?.href ?? 'https://88cutouts.com/';
const pageUrl = new URL(`/stickers/${entry.slug}/`, site).href;
const label = category.charAt(0).toUpperCase() + category.slice(1);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    name: title,
    description: `Free transparent ${type} — ${title}. Copy and paste it into an Instagram Story.`,
    contentUrl: new URL(image, site).href,
    url: pageUrl,
    encodingFormat: 'image/png',
    keywords: [category, ...tags].join(', '),
    creator: { '@type': 'Organization', name: '88cutouts', url: site },
    license: pageUrl,
    acquireLicensePage: new URL('/about/', site).href,
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      {
        '@type': 'ListItem',
        position: 2,
        name: label,
        item: new URL(`/category/${category}/`, site).href,
      },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${title} — free ${type} | 88cutouts`}
  description={`Free transparent ${type} sticker: ${title}. Tap to copy and paste directly into your Instagram Story.`}
  image={image}
  jsonld={jsonld}
>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a><span>/</span><a href={`/category/${category}/`}>{label}</a><span>/</span
      >{title}
    </p>

    <article class="sticker-page">
      <div class="preview-frame">
        <img
          src={heroThumb}
          alt={`${title} — transparent PNG ${type} for Instagram Stories`}
          width="512"
          height="512"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div>
        <h1>{title}</h1>
        <div class="meta">
          <a class="tag is-category" href={`/category/${category}/`}>{category}</a>
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <CopyDownloadButtons imageSrc={image} filename={`${entry.slug}.png`} />
      </div>
    </article>

    {
      related.length > 0 && (
        <>
          <div class="section-head">
            <h2>More {category} stickers</h2>
            <a class="count" href={`/category/${category}/`}>
              See all →
            </a>
          </div>
          <div class="grid">
            {related.map((r) => (
              <StickerCard entry={r} />
            ))}
          </div>
        </>
      )
    }

    <AdSlot />
  </div>
</BaseLayout>
