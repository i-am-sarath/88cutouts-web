---
import type { CollectionEntry } from 'astro:content';
import { getStickers } from '../../lib/stickers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CopyDownloadButtons from '../../components/CopyDownloadButtons.astro';
import StickerCard from '../../components/StickerCard.astro';
import StickerShuffle from '../../components/StickerShuffle.astro';
import { stickerThumb } from '../../lib/thumbs.mjs';
import { getImageMeta } from '../../lib/image-meta';
import { specs } from '../../lib/sticker-copy';

export async function getStaticPaths() {
  const items = await getStickers();
  return items.map((s) => ({
    params: { slug: s.slug },
    props: {
      entry: s,
      related: items
        .filter((r) => r.slug !== s.slug && r.data.category === s.data.category)
        .slice(0, 6),
      // Cross-category suggestions, so a page isn't a dead end when its own
      // shelf is small.
      elsewhere: items.filter((r) => r.data.category !== s.data.category),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'stickers'>;
  related: CollectionEntry<'stickers'>[];
  elsewhere: CollectionEntry<'stickers'>[];
}

const { entry, related, elsewhere } = Astro.props;
const { title, image, category, type } = entry.data;
// The category already has its own chip — don't repeat it in the tag row.
const tags = entry.data.tags.filter((t) => t.toLowerCase() !== category.toLowerCase());
const { Content } = await entry.render();

// Hero shows the lightweight WebP; Copy/Download still fetch the full PNG.
const heroThumb = stickerThumb(image, 512);

const meta = getImageMeta(image);
const specRows = specs(meta, type);

// Three named siblings to send people to, and the other shelves worth a look.
const pairWith = related.slice(0, 3);
const otherCategories = [...new Set(elsewhere.map((s) => s.data.category))]
  .filter((c) => c !== category)
  .slice(0, 4);

const site = Astro.site?.href ?? 'https://88cutouts.com/';
const pageUrl = new URL(`/stickers/${entry.slug}/`, site).href;
const label = category.charAt(0).toUpperCase() + category.slice(1);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    name: title,
    description: `Free transparent ${type} — ${title}. Copy and paste it into an Instagram Story.`,
    contentUrl: new URL(image, site).href,
    url: pageUrl,
    encodingFormat: 'image/png',
    ...(meta ? { width: meta.w, height: meta.h, contentSize: `${meta.bytes}` } : {}),
    keywords: [category, ...tags].join(', '),
    license: new URL('/license/', site).href,
    acquireLicensePage: new URL('/license/', site).href,
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      {
        '@type': 'ListItem',
        position: 2,
        name: label,
        item: new URL(`/category/${category}/`, site).href,
      },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },

];
---

<BaseLayout
  title={`${title} — free ${type} | 88cutouts`}
  description={`Free transparent PNG ${type}: ${title}${meta ? `, ${meta.w} × ${meta.h}px` : ''}. Copy it at any opacity and paste straight into your Instagram Story.`}
  image={image}
  jsonld={jsonld}
>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a><span>/</span><a href={`/category/${category}/`}>{label}</a><span>/</span
      >{title}
    </p>

    <article class="sticker-page">
      <div class="preview-frame">
        <img
          src={heroThumb}
          alt={`${title} — transparent PNG ${type} for Instagram Stories`}
          width="512"
          height="512"
          loading="eager"
          fetchpriority="high"
          data-opacity-preview
        />
      </div>

      <div>
        <h1>{title}</h1>
        <div class="meta">
          <a class="tag is-category" href={`/category/${category}/`}>{category}</a>
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <CopyDownloadButtons imageSrc={image} filename={`${entry.slug}.png`} opacity={true} />
        <div class="sticker-desc">
          <Content />
        </div>

        <dl class="spec-list">
          {
            specRows.map((row) => (
              <div class="spec-row">
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </article>

    <article class="prose sticker-prose">
      <h2>Check the edges before you use it</h2>
      <p>Compare {title} on light and dark backgrounds. These previews use the same PNG as the download, so you can check pale details and transparent margins before adding it to your design.</p>
      <div class="asset-proof">
        <figure class="proof-light"><img src={image} alt={`${title} on a light background`} width="320" height="320" loading="lazy" /><figcaption>Light background</figcaption></figure>
        <figure class="proof-dark"><img src={image} alt={`${title} on a dark background`} width="320" height="320" loading="lazy" /><figcaption>Dark background</figcaption></figure>
      </div>
      <p>Use the opacity slider above to change the exported file. Start at 100% to inspect the edges; lower it only if you want a translucent result. See <a href="/blog/sticker-opacity-over-photos/">the opacity comparison</a> for an example.</p>
      <p><a href="/license/">Read the personal-use licence</a>. If a file looks wrong, <a href="/contact/">report it with this page's address</a>.</p>

      {
        pairWith.length > 0 && (
          <p>
            Closest matches in the library:{' '}
            {pairWith.map((s, i) => (
              <>
                {i > 0 && (i === pairWith.length - 1 ? ' and ' : ', ')}
                <a href={`/stickers/${s.slug}/`}>{s.data.title}</a>
              </>
            ))}
            . The rest of the shelf is in{' '}
            <a href={`/category/${category}/`}>{label.toLowerCase()}</a>
            {otherCategories.length > 0 && (
              <>
                , and for a different mood there is{' '}
                {otherCategories.map((c, i) => (
                  <>
                    {i > 0 && (i === otherCategories.length - 1 ? ' or ' : ', ')}
                    <a href={`/category/${c}/`}>{c}</a>
                  </>
                ))}
              </>
            )}
            .
          </p>
        )
      }

      <p>Need help saving or pasting? <a href="/help/">Download and clipboard help</a> covers the available alternatives.</p>
    </article>

    <AdSlot />

    {
      related.length > 0 && (
        <>
          <div class="section-head">
            <h2>More {category} stickers</h2>
            <a class="count" href={`/category/${category}/`}>
              See all →
            </a>
          </div>
          <div class="grid">
            {related.map((r) => (
              <StickerCard entry={r} />
            ))}
          </div>
        </>
      )
    }

    <StickerShuffle pool={elsewhere} count={6} id="sticker" heading="Try one of these next" />
  </div>
</BaseLayout>
