---
interface Props {
  imageSrc: string;
  filename: string;
  /**
   * Download the file exactly as served instead of re-encoding it to PNG.
   * Stickers need the PNG round-trip to guarantee alpha; a DP is an opaque
   * JPEG, and re-encoding a 900px photographic image to PNG turns a 90 KB
   * download into well over a megabyte for no gain.
   */
  downloadOriginal?: boolean;
  /** Replaces the Instagram-Stories transparency note. */
  hint?: string;
  /**
   * Show the opacity control. Only makes sense where the output is a
   * transparent PNG — a translucent sticker is what people want when they are
   * laying one over a photo in a Story.
   */
  opacity?: boolean;
  /**
   * Sticker pages pass these to get the Share and tray buttons beside
   * Copy/Download.
   */
  sticker?: { slug: string; title: string; thumb: string };
}

const {
  imageSrc,
  filename,
  downloadOriginal = false,
  hint,
  opacity = false,
  sticker,
} = Astro.props;
---

<div class="action-block">
  {
    opacity && (
      <div class="opacity-ctl">
        <div class="opacity-head">
          <div class="opacity-presets" role="group" aria-label="Opacity presets">
            <button type="button" class="chip" data-op="100" aria-pressed="true">
              Solid
            </button>
            <button type="button" class="chip" data-op="70" aria-pressed="false">
              Soft
            </button>
            <button type="button" class="chip" data-op="45" aria-pressed="false">
              Faded
            </button>
            <button type="button" class="chip" data-op="20" aria-pressed="false">
              Ghost
            </button>
          </div>
          <span class="opacity-val" title="Opacity">100%</span>
        </div>

        <input
          class="opacity-range"
          type="range"
          min="5"
          max="100"
          step="5"
          value="100"
          aria-label="Sticker opacity percentage"
        />
      </div>
    )
  }

  <div
    class:list={['action-row', sticker && 'is-sticker']}
    data-src={imageSrc}
    data-title={sticker?.title}
    data-filename={filename}
    data-download-original={downloadOriginal ? 'true' : undefined}
  >
    <button class="btn-copy" type="button">Copy</button>
    <button class="btn-download" type="button">Download</button>
    {
      sticker && (
        <>
          <button class="btn-icon btn-share" type="button" aria-label={`Share ${sticker.title}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" /><path d="M8.3 10.7l7.4-4.3M8.3 13.3l7.4 4.3" /></svg>
          </button>
          <button
            class="btn-icon"
            type="button"
            data-tray
            data-slug={sticker.slug}
            data-title={sticker.title}
            data-thumb={sticker.thumb}
            aria-pressed="false"
            aria-label={`Add ${sticker.title} to your tray`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13l2.5-8h13L21 13v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M3 13h5a4 4 0 0 0 8 0h5" /></svg>
          </button>
        </>
      )
    }
  </div>
  <p class="copy-hint">
    {
      hint ? (
        hint
      ) : (
        <>
          Works best pasted into Instagram <strong>Stories</strong> — feed posts don't show
          transparency.
        </>
      )
    }
  </p>
</div>

<script>
  import { track } from '../lib/track';

  function showToast(msg) {
    let toast = document.getElementById('global-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'global-toast';
      toast.setAttribute('role', 'status');
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  /**
   * The clipboard only reliably accepts image/png, so anything else gets
   * re-encoded through a canvas (alpha is preserved). Anything below full
   * opacity always takes the canvas path — that is where the alpha is applied.
   */
  async function toPngBlob(src, alpha = 1) {
    const res = await fetch(src);
    if (!res.ok) throw new Error(`Failed to fetch ${src}`);
    const blob = await res.blob();
    if (blob.type === 'image/png' && alpha >= 1) return blob;

    const bitmap = await createImageBitmap(blob);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    const ctx = canvas.getContext('2d');
    ctx.globalAlpha = alpha;
    ctx.drawImage(bitmap, 0, 0);
    return await new Promise((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode failed'))), 'image/png')
    );
  }

  async function copyImage(src, slug, alpha) {
    if (!navigator.clipboard || typeof ClipboardItem === 'undefined') {
      showToast("Copy isn't supported here — tap Download instead.");
      // How often the core interaction is unavailable is worth knowing.
      track('sticker_copy_unsupported', { sticker: slug, reason: 'no_clipboard_api' });
      return;
    }

    // Kick the fetch off inside the click handler so Safari keeps the user
    // gesture alive; the promise is handed straight to ClipboardItem.
    const pending = toPngBlob(src, alpha);
    pending.catch(() => {});

    const opacity = Math.round(alpha * 100);

    try {
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': pending })]);
      showToast('Copied! Paste into your Instagram Story.');
      track('sticker_copy', { sticker: slug, method: 'promise', opacity });
      return;
    } catch {
      /* Browser rejects promise-valued ClipboardItem — retry with the blob. */
    }

    try {
      const blob = await pending;
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
      showToast('Copied! Paste into your Instagram Story.');
      track('sticker_copy', { sticker: slug, method: 'blob', opacity });
    } catch {
      showToast("Copy isn't supported here — tap Download instead.");
      track('sticker_copy_unsupported', { sticker: slug, reason: 'write_rejected' });
    }
  }

  async function downloadImage(src, filename, original, alpha) {
    try {
      // Serving the original bytes only works at full opacity; a translucent
      // version has to be re-encoded through the canvas.
      const blob =
        original && alpha >= 1 ? await (await fetch(src)).blob() : await toPngBlob(src, alpha);
      const opacity = Math.round(alpha * 100);
      const name = alpha >= 1 ? filename : `${filename.replace(/\.\w+$/, '')}-${opacity}.png`;
      track('sticker_download', { sticker: filename.replace(/\.\w+$/, ''), opacity });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    } catch {
      showToast('Download failed — try again.');
    }
  }

  /**
   * Hands the PNG itself to the phone's share sheet (WhatsApp, Instagram,
   * Messages…) where the browser can share files; otherwise shares or copies
   * the page link.
   */
  async function shareImage(src, filename, title, alpha) {
    const slug = filename.replace(/\.\w+$/, '');
    const url = location.href;
    try {
      if (navigator.canShare) {
        const blob = await toPngBlob(src, alpha);
        const file = new File([blob], filename, { type: 'image/png' });
        if (navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title });
          track('sticker_share', { sticker: slug, method: 'file' });
          return;
        }
      }
      if (navigator.share) {
        await navigator.share({ title, url });
        track('sticker_share', { sticker: slug, method: 'link' });
        return;
      }
      await navigator.clipboard.writeText(url);
      showToast('Link copied. Paste it anywhere to share.');
      track('sticker_share', { sticker: slug, method: 'clipboard' });
    } catch (err) {
      // Closing the share sheet is not a failure.
      if (err && err.name === 'AbortError') return;
      showToast("Sharing isn't available here. Try Download.");
    }
  }

  /**
   * Wires the opacity control to its live preview and hands back a getter, so
   * the copy/download handlers always read the current value rather than one
   * captured at setup.
   */
  function wireOpacity(block) {
    const ctl = block?.querySelector('.opacity-ctl');
    if (!ctl) return () => 1;

    const range = ctl.querySelector('.opacity-range');
    const readout = ctl.querySelector('.opacity-val');
    const chips = [...ctl.querySelectorAll('.chip[data-op]')];
    // Any image on the page that should follow the slider — the hero preview.
    const previews = [...document.querySelectorAll('[data-opacity-preview]')];
    let value = 100;

    function apply(next, fromRange) {
      value = Math.min(100, Math.max(5, Math.round(next)));
      if (range && !fromRange) range.value = String(value);
      if (readout) readout.textContent = `${value}%`;
      for (const el of previews) el.style.opacity = String(value / 100);
      for (const chip of chips) {
        chip.setAttribute(
          'aria-pressed',
          Number(chip.getAttribute('data-op')) === value ? 'true' : 'false'
        );
      }
    }

    range?.addEventListener('input', () => apply(Number(range.value), true));
    for (const chip of chips) {
      chip.addEventListener('click', () =>
        apply(Number(chip.getAttribute('data-op')), false)
      );
    }

    return () => value / 100;
  }

  document.querySelectorAll('.action-row[data-src]').forEach((row) => {
    const src = row.getAttribute('data-src');
    const filename = row.getAttribute('data-filename') || 'sticker.png';
    if (!src) return;
    const slug = filename.replace(/\.\w+$/, '');
    const original = row.getAttribute('data-download-original') === 'true';
    const alpha = wireOpacity(row.closest('.action-block'));

    row
      .querySelector('.btn-copy')
      ?.addEventListener('click', () => copyImage(src, slug, alpha()));
    row
      .querySelector('.btn-download')
      ?.addEventListener('click', () => downloadImage(src, filename, original, alpha()));
    row
      .querySelector('.btn-share')
      ?.addEventListener('click', () =>
        shareImage(src, filename, row.getAttribute('data-title') || 'Sticker', alpha())
      );
  });
</script>
