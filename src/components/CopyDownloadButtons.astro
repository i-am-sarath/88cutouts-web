---
interface Props {
  imageSrc: string;
  filename: string;
  /**
   * Download the file exactly as served instead of re-encoding it to PNG.
   * Stickers need the PNG round-trip to guarantee alpha; a DP is an opaque
   * JPEG, and re-encoding a 900px photographic image to PNG turns a 90 KB
   * download into well over a megabyte for no gain.
   */
  downloadOriginal?: boolean;
  /** Replaces the Instagram-Stories transparency note. */
  hint?: string;
}

const { imageSrc, filename, downloadOriginal = false, hint } = Astro.props;
---

<div
  class="action-row"
  data-src={imageSrc}
  data-filename={filename}
  data-download-original={downloadOriginal ? 'true' : undefined}
>
  <button class="btn-copy" type="button">Copy</button>
  <button class="btn-download" type="button">Download</button>
</div>
<p class="copy-hint">
  {
    hint ? (
      hint
    ) : (
      <>
        Works best pasted into Instagram <strong>Stories</strong> — feed posts don't show
        transparency.
      </>
    )
  }
</p>

<script>
  import { track } from '../lib/track';

  function showToast(msg) {
    let toast = document.getElementById('global-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'global-toast';
      toast.setAttribute('role', 'status');
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  /**
   * The clipboard only reliably accepts image/png, so anything else gets
   * re-encoded through a canvas (alpha is preserved).
   */
  async function toPngBlob(src) {
    const res = await fetch(src);
    if (!res.ok) throw new Error(`Failed to fetch ${src}`);
    const blob = await res.blob();
    if (blob.type === 'image/png') return blob;

    const bitmap = await createImageBitmap(blob);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    canvas.getContext('2d').drawImage(bitmap, 0, 0);
    return await new Promise((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode failed'))), 'image/png')
    );
  }

  async function copyImage(src, slug) {
    if (!navigator.clipboard || typeof ClipboardItem === 'undefined') {
      showToast("Copy isn't supported here — tap Download instead.");
      // How often the core interaction is unavailable is worth knowing.
      track('sticker_copy_unsupported', { sticker: slug, reason: 'no_clipboard_api' });
      return;
    }

    // Kick the fetch off inside the click handler so Safari keeps the user
    // gesture alive; the promise is handed straight to ClipboardItem.
    const pending = toPngBlob(src);
    pending.catch(() => {});

    try {
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': pending })]);
      showToast('Copied! Paste into your Instagram Story.');
      track('sticker_copy', { sticker: slug, method: 'promise' });
      return;
    } catch {
      /* Browser rejects promise-valued ClipboardItem — retry with the blob. */
    }

    try {
      const blob = await pending;
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
      showToast('Copied! Paste into your Instagram Story.');
      track('sticker_copy', { sticker: slug, method: 'blob' });
    } catch {
      showToast("Copy isn't supported here — tap Download instead.");
      track('sticker_copy_unsupported', { sticker: slug, reason: 'write_rejected' });
    }
  }

  async function downloadImage(src, filename, original) {
    try {
      const blob = original ? await (await fetch(src)).blob() : await toPngBlob(src);
      track('sticker_download', { sticker: filename.replace(/\.\w+$/, '') });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    } catch {
      showToast('Download failed — try again.');
    }
  }

  document.querySelectorAll('.action-row[data-src]').forEach((row) => {
    const src = row.getAttribute('data-src');
    const filename = row.getAttribute('data-filename') || 'sticker.png';
    if (!src) return;
    const slug = filename.replace(/\.\w+$/, '');
    const original = row.getAttribute('data-download-original') === 'true';

    row.querySelector('.btn-copy')?.addEventListener('click', () => copyImage(src, slug));
    row
      .querySelector('.btn-download')
      ?.addEventListener('click', () => downloadImage(src, filename, original));
  });
</script>
