---
/**
 * Canvas cut-out text maker. Letter cutouts come from the CMS-managed
 * letters.json, exposed as /ransom-letters-manifest.json (character -> variants).
 * Characters with no uploaded cutout fall back to a plain drawn glyph.
 *
 * It opens with a phrase already rendered rather than an empty box: the tool
 * is hard to understand from a label alone, and one look at the output
 * explains it faster than any instruction does.
 */

/** Tapping one of these is the fastest possible path to a finished image. */
const presets = [
  'happy birthday',
  'hi bestie',
  'miss you',
  'save the date',
  'congrats!',
  'thank you',
  'good vibes',
  'best friends',
  'my era',
  '2026',
];
---

<div class="text-tool">
  <div class="tt-step">
    <span class="tt-step-n">1</span>
    <h3>Tap a phrase, or type your own</h3>
  </div>

  <div class="tt-presets" role="group" aria-label="Example phrases">
    {
      presets.map((p) => (
        <button type="button" class="chip" data-preset={p}>
          {p}
        </button>
      ))
    }
  </div>

  <label class="sr-only" for="ransom-input">Your message</label>
  <textarea
    id="ransom-input"
    maxlength="140"
    rows="2"
    placeholder="Type your message…"
    autocapitalize="none"
    spellcheck="false"></textarea>
  <p class="ransom-count"><span id="ransom-count">0</span>/140</p>

  <div class="tt-step">
    <span class="tt-step-n">2</span>
    <h3>Check the preview</h3>
  </div>

  <div class="canvas-frame">
    <canvas
      id="ransom-canvas"
      width="900"
      height="320"
      role="img"
      aria-label="Live preview of your cut-out letter message"></canvas>
  </div>

  <div class="tt-tweaks">
    <button type="button" class="chip tt-shuffle" id="ransom-shuffle">
      ↻ Shuffle the cut
    </button>
    <div class="tt-sizes" role="group" aria-label="Letter size">
      <button type="button" class="chip" data-size="42" aria-pressed="false">Small</button>
      <button type="button" class="chip" data-size="56" aria-pressed="true">Medium</button>
      <button type="button" class="chip" data-size="76" aria-pressed="false">Large</button>
    </div>
  </div>

  <div class="opacity-ctl">
    <div class="opacity-head">
      <span class="opacity-title">Opacity</span>
      <span class="opacity-val">100%</span>
    </div>
    <div class="opacity-presets" role="group" aria-label="Opacity presets">
      <button type="button" class="chip" data-op="100" aria-pressed="true">Solid</button>
      <button type="button" class="chip" data-op="70" aria-pressed="false">Soft</button>
      <button type="button" class="chip" data-op="45" aria-pressed="false">Faded</button>
      <button type="button" class="chip" data-op="20" aria-pressed="false">Ghost</button>
    </div>
    <input
      class="opacity-range"
      type="range"
      min="5"
      max="100"
      step="5"
      value="100"
      aria-label="Letter opacity percentage"
    />
    <p class="opacity-note">
      Lower it for lettering that sits over a photo without covering it.
      <strong>Copy</strong> and <strong>Download</strong> both use what you set here.
    </p>
  </div>

  <div class="tt-step">
    <span class="tt-step-n">3</span>
    <h3>Copy it, then paste into your Story</h3>
  </div>

  <div class="action-row">
    <button id="ransom-copy" class="btn-copy" type="button">Copy</button>
    <button id="ransom-download" class="btn-download" type="button">Download</button>
  </div>
  <p class="copy-hint">
    Open Instagram, start a Story, and long-press to paste. Works best in
    <strong>Stories</strong> — feed posts don't show transparency.
  </p>
</div>

<script>
  import { track } from '../lib/track';

  /** Rendered before anyone types, so the tool explains itself on arrival. */
  const OPENING_PHRASE = 'hi bestie';

  let SIZE = 56;
  const PAD = 20;
  /**
   * Gap between adjacent cutouts, as a fraction of SIZE. Scrap widths vary a
   * lot once trimmed, and each is rotated up to 8 degrees, so a small positive
   * gap is needed to stop neighbours overlapping into illegibility.
   */
  const KERN = 0.06;
  /** Fixed wrap width; the canvas itself is then trimmed to the content. */
  const WRAP_W = 860;
  const MIN_WIDTH = 360;
  const MIN_HEIGHT = 200;

  const lineHeight = () => SIZE * 1.15;
  const advText = () => SIZE * 0.6;
  const advSpace = () => SIZE * 0.6;

  /** @type {Record<string, string[]>} */
  let manifest = {};
  /** @type {Map<string, Promise<HTMLImageElement|null>>} */
  const imageCache = new Map();
  /** Per-position choices, so already-typed letters don't reshuffle on each keystroke. */
  let slots = [];
  let renderToken = 0;
  let alpha = 1;

  const canvas = /** @type {HTMLCanvasElement} */ (document.getElementById('ransom-canvas'));
  const input = /** @type {HTMLTextAreaElement} */ (document.getElementById('ransom-input'));
  const counter = document.getElementById('ransom-count');

  function showToast(msg) {
    let toast = document.getElementById('global-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'global-toast';
      toast.setAttribute('role', 'status');
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  async function loadManifest() {
    try {
      const res = await fetch('/ransom-letters-manifest.json');
      manifest = await res.json();
    } catch {
      manifest = {};
    }
    // The opening phrase is rendered before this resolves, and syncSlots keeps
    // an existing slot when its character hasn't changed — so without clearing
    // them, those first letters would stay on the drawn-glyph fallback for the
    // life of the page.
    slots = [];
    render(input?.value ?? '');
  }

  function variantsFor(char) {
    return manifest[char.toLowerCase()] || [];
  }

  function loadImage(src) {
    if (!imageCache.has(src)) {
      imageCache.set(
        src,
        new Promise((resolve) => {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => resolve(img);
          img.onerror = () => resolve(null);
          img.src = src;
        })
      );
    }
    return imageCache.get(src);
  }

  /** Reuse the existing choice when the character at this position is unchanged. */
  function syncSlots(chars) {
    slots.length = chars.length;
    chars.forEach((char, i) => {
      if (slots[i] && slots[i].char === char) return;
      const variants = variantsFor(char);
      slots[i] = {
        char,
        src: variants.length ? variants[Math.floor(Math.random() * variants.length)] : null,
        angle: (Math.random() * 16 - 8) * (Math.PI / 180),
        jitterY: Math.random() * 8 - 4,
      };
    });
  }

  /**
   * Cutouts are not square — a '!' scrap is tall and narrow, a '-' scrap is
   * wide and short. Each is drawn at a fixed height with its own width, so the
   * advance depends on the loaded image's aspect ratio.
   */
  function advance(slot) {
    if (slot.char === ' ') return advSpace();
    if (!slot.src) return advText();
    return (slot.w || SIZE) + SIZE * KERN;
  }

  /** Fill in drawn width/height for each slot from its loaded image. */
  function measure(slots, images) {
    for (const slot of slots) {
      const img = slot.src ? images.get(slot.src) : null;
      if (!img || !img.naturalWidth) {
        slot.w = SIZE;
        slot.h = SIZE;
        continue;
      }
      slot.h = SIZE;
      slot.w = Math.max(1, (img.naturalWidth / img.naturalHeight) * SIZE);
    }
  }

  /** Greedy word wrap; a single word longer than the line still breaks mid-word. */
  function layout(slots, maxWidth) {
    const lines = [];
    let line = [];
    let x = 0;
    let word = [];
    let wordWidth = 0;

    const flushWord = () => {
      if (!word.length) return;
      if (x + wordWidth > maxWidth && line.length) {
        lines.push(line);
        line = [];
        x = 0;
      }
      for (const s of word) {
        if (x + advance(s) > maxWidth && line.length) {
          lines.push(line);
          line = [];
          x = 0;
        }
        line.push({ ...s, x });
        x += advance(s);
      }
      word = [];
      wordWidth = 0;
    };

    for (const slot of slots) {
      if (slot.char === '\n') {
        flushWord();
        lines.push(line);
        line = [];
        x = 0;
      } else if (slot.char === ' ') {
        flushWord();
        if (line.length) {
          line.push({ ...slot, x });
          x += advSpace();
        }
      } else {
        word.push(slot);
        wordWidth += advance(slot);
      }
    }
    flushWord();
    if (line.length) lines.push(line);
    return lines;
  }

  async function render(text) {
    const token = ++renderToken;
    const ctx = canvas.getContext('2d');

    syncSlots([...text]);

    // Preload every cutout this render needs before touching the canvas, so
    // fast typing can never interleave two half-finished renders — and so the
    // layout can measure each scrap's real aspect ratio.
    const srcs = [...new Set(slots.map((s) => s.src).filter(Boolean))];
    const images = new Map(
      await Promise.all(srcs.map(async (src) => [src, await loadImage(src)]))
    );
    if (token !== renderToken) return;

    measure(slots, images);
    const lines = layout(slots, WRAP_W);

    // Trim the canvas to the drawn content: empty transparent margin would
    // otherwise shrink the sticker once it's pasted into a Story.
    const contentW = lines.reduce((w, line) => {
      const glyphs = line.filter((s) => s.char !== ' ');
      const last = glyphs[glyphs.length - 1];
      return last ? Math.max(w, last.x + advance(last)) : w;
    }, 0);

    canvas.width = Math.round(Math.max(MIN_WIDTH, contentW + PAD * 2));
    canvas.height = Math.round(
      Math.max(MIN_HEIGHT, PAD * 2 + Math.max(lines.length, 1) * lineHeight())
    );

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.globalAlpha = alpha;

    let y = PAD + 20;
    for (const line of lines) {
      for (const slot of line) {
        if (slot.char === ' ') continue;
        const x = PAD + slot.x;
        const img = slot.src ? images.get(slot.src) : null;

        if (!img) {
          ctx.font = `700 ${SIZE * 0.7}px Quicksand, sans-serif`;
          ctx.fillStyle = '#2B2B2B';
          ctx.fillText(slot.char, x, y + SIZE * 0.6);
          continue;
        }

        const dw = slot.w || SIZE;
        const dh = slot.h || SIZE;
        ctx.save();
        ctx.translate(x + dw / 2, y + slot.jitterY + dh / 2);
        ctx.rotate(slot.angle);
        ctx.drawImage(img, -dw / 2, -dh / 2, dw, dh);
        ctx.restore();
      }
      y += lineHeight();
    }
    ctx.globalAlpha = 1;
  }

  function setText(value, source) {
    if (!input) return;
    input.value = value.slice(0, 140);
    if (counter) counter.textContent = String(input.value.length);
    render(input.value);
    if (source) track('ransom_preset', { phrase: value });
  }

  function canvasBlob() {
    return new Promise((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode failed'))), 'image/png')
    );
  }

  input?.addEventListener('input', () => {
    if (counter) counter.textContent = String(input.value.length);
    render(input.value);
  });

  // ---- presets -------------------------------------------------------------

  document.querySelectorAll('.tt-presets .chip[data-preset]').forEach((chip) => {
    chip.addEventListener('click', () => {
      setText(chip.getAttribute('data-preset') || '', 'preset');
      input?.focus();
    });
  });

  // ---- shuffle -------------------------------------------------------------

  document.getElementById('ransom-shuffle')?.addEventListener('click', () => {
    slots = [];
    render(input?.value ?? '');
    track('ransom_shuffle', {});
  });

  // ---- letter size ---------------------------------------------------------

  const sizeChips = [...document.querySelectorAll('.tt-sizes .chip[data-size]')];
  for (const chip of sizeChips) {
    chip.addEventListener('click', () => {
      SIZE = Number(chip.getAttribute('data-size'));
      for (const c of sizeChips) {
        c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
      }
      render(input?.value ?? '');
    });
  }

  // ---- opacity -------------------------------------------------------------

  const opCtl = document.querySelector('.text-tool .opacity-ctl');
  if (opCtl) {
    const range = opCtl.querySelector('.opacity-range');
    const readout = opCtl.querySelector('.opacity-val');
    const opChips = [...opCtl.querySelectorAll('.chip[data-op]')];

    const applyOpacity = (next, fromRange) => {
      const value = Math.min(100, Math.max(5, Math.round(next)));
      alpha = value / 100;
      if (range && !fromRange) range.value = String(value);
      if (readout) readout.textContent = `${value}%`;
      for (const c of opChips) {
        c.setAttribute(
          'aria-pressed',
          Number(c.getAttribute('data-op')) === value ? 'true' : 'false'
        );
      }
      render(input?.value ?? '');
    };

    range?.addEventListener('input', () => applyOpacity(Number(range.value), true));
    for (const c of opChips) {
      c.addEventListener('click', () => applyOpacity(Number(c.getAttribute('data-op')), false));
    }
  }

  // ---- export --------------------------------------------------------------

  document.getElementById('ransom-copy')?.addEventListener('click', async () => {
    if (!input?.value.trim()) {
      showToast('Tap a phrase above, or type your own.');
      input?.focus();
      return;
    }
    if (!navigator.clipboard || typeof ClipboardItem === 'undefined') {
      showToast("Copy isn't supported here — tap Download instead.");
      return;
    }

    const pending = canvasBlob();
    pending.catch(() => {});
    const opacity = Math.round(alpha * 100);

    try {
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': pending })]);
      showToast('Copied! Paste into your Instagram Story.');
      track('ransom_copy', { length: input.value.length, opacity });
      return;
    } catch {
      /* retry with a resolved blob below */
    }
    try {
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': await pending })]);
      showToast('Copied! Paste into your Instagram Story.');
      track('ransom_copy', { length: input.value.length, opacity });
    } catch {
      showToast("Copy isn't supported here — tap Download instead.");
      track('ransom_copy_unsupported', { length: input.value.length });
    }
  });

  document.getElementById('ransom-download')?.addEventListener('click', () => {
    if (!input?.value.trim()) {
      showToast('Tap a phrase above, or type your own.');
      input?.focus();
      return;
    }
    const opacity = Math.round(alpha * 100);
    track('ransom_download', { length: input.value.length, opacity });
    const a = document.createElement('a');
    a.download = opacity >= 100 ? 'cutout-text.png' : `cutout-text-${opacity}.png`;
    a.href = canvas.toDataURL('image/png');
    document.body.appendChild(a);
    a.click();
    a.remove();
  });

  setText(OPENING_PHRASE);
  loadManifest();
</script>
