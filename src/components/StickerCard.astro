---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'stickers'>;
  /** The first row of a gallery loads eagerly; everything else lazily. */
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, image, category, type } = entry.data;

// Display uses the generated square WebP thumbnails; the full PNG in `image`
// stays reserved for copy/download. See scripts/generate-thumbs.mjs.
const base = image.replace(/^\/stickers\//, '').replace(/\.png$/i, '');
const thumb = (size: number) => `/stickers/thumbs/${base}-${size}.webp`;
---

<a class="card" href={`/stickers/${entry.slug}/`}>
  <div class="checker">
    <img
      src={thumb(400)}
      srcset={`${thumb(200)} 200w, ${thumb(400)} 400w`}
      sizes="(max-width: 480px) 45vw, 200px"
      alt={`${title} — transparent PNG ${type} for Instagram Stories`}
      width="400"
      height="400"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="card-meta">
    <div class="card-title">{title}</div>
    <div class="card-sub">{category}</div>
  </div>
</a>
