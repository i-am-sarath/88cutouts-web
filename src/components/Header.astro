---
import SearchBar from './SearchBar.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const onSticker = isActive('/stickers') || isActive('/category');
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="88cutouts home">
      <span class="spark" aria-hidden="true">✂</span>88cutouts
    </a>

    <div class="search-wrap">
      <SearchBar />
    </div>

    <nav class="header-nav" aria-label="Main">
      <a class="nav-cta" href="/scrapbook/" aria-current={isActive('/scrapbook') ? 'page' : undefined}>Scrapbook</a>
      <a href="/stickers/" aria-current={onSticker ? 'page' : undefined}>Stickers</a>
      <a href="/packs/" aria-current={isActive('/packs') ? 'page' : undefined}>Packs</a>
      <a href="/symbols/" aria-current={isActive('/symbols') ? 'page' : undefined}>Symbols</a>
    </nav>
  </div>
</header>
