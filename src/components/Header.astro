---
import SearchBar from './SearchBar.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="88cutouts home">
      <span class="spark" aria-hidden="true">✦</span>88cutouts
    </a>

    <div class="search-wrap">
      <SearchBar />
    </div>

    <nav class="header-nav" aria-label="Main">
      <a href="/dp/" aria-current={isActive('/dp/') ? 'page' : undefined}>DP</a>
      <a href="/dp-maker/" aria-current={isActive('/dp-maker') ? 'page' : undefined}>
        DP Maker
      </a>
      <a href="/ransom-note/" aria-current={isActive('/ransom-note') ? 'page' : undefined}>
        Ransom Note
      </a>
      <a href="/blog/" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
      <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>
